import java.util.Scanner;
public class sample{
    public static void main(String[]args){
            Scanner cs = new Scanner(System.in);
            int n,i;
            System.out.println("Enter number: ");
            n=cs.nextInt();
            for(i=1;i<=10;i++){
                        System.out.println(n+"x"+i+"="+(n*i));
            }
    }
}
                    
