    int[] arr=new int [n];
    System.out.println("Enter elements of array: ");
    for(int i=0;i<n;i++){
      arr[i] = cs.nextInt();
    }
    for(int j=0;j<arr.length;j++){
      boolean dupe=false;
      for(int k=0;k<j;k++){
        if(arr[j]==arr[k]){
          dupe = true;
          break;
        }
      }
    if(!dupe){
      System.out.print(arr[i]+" ");
    }
    }
  }
}
