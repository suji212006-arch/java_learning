import java.util.Scanner;
public class sample{
    public static void main(String[]args){
            int r;
            double area,peri;
            Scanner cs = new Scanner(System.in);
            System.out.println("Enter radius:");
            r=cs.nextInt();
            area=3.14*r*r;
            System.out.println("Area:"+area);
            peri=2*3.14*r;
            System.out.println("Perimeter:"+peri);
    }
}
